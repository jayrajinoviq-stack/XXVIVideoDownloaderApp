<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.XXVIVideoDownloader" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg_home_cream</item>
        <item name="android:statusBarColor">@color/bg_home_cream</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@color/bg_home_cream</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.XXVIVideoDownloader" parent="Base.Theme.XXVIVideoDownloader" />

    <style name="Theme.XXVIVideoDownloader.SlideFromLeft" parent="Theme.XXVIVideoDownloader">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/Animation.SlideFromLeft</item>
    </style>

    <style name="Animation.SlideFromLeft" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityOpenExitAnimation">@anim/no_anim</item>
        <item name="android:activityCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_left</item>
        <item name="android:taskOpenEnterAnimation">@anim/slide_in_left</item>
        <item name="android:taskOpenExitAnimation">@anim/no_anim</item>
        <item name="android:taskCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:taskCloseExitAnimation">@anim/slide_out_left</item>
        <item name="android:taskToFrontEnterAnimation">@anim/slide_in_left</item>
        <item name="android:taskToFrontExitAnimation">@anim/no_anim</item>
        <item name="android:taskToBackEnterAnimation">@anim/no_anim</item>
        <item name="android:taskToBackExitAnimation">@anim/slide_out_left</item>
    </style>

    <style name="Theme.XXVIVideoDownloader.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_color</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/app_logo</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.XXVIVideoDownloader</item>
    </style>

    <style name="ShapeAppearance.RoundedSmall" parent="">
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearance.RoundedMedium" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="CustomCapsuleSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumb">@drawable/bg_switch_thumb</item>
        <item name="track">@drawable/bg_switch_track</item>
        <item name="thumbTint">@null</item>
        <item name="trackTint">@null</item>
        <item name="splitTrack">false</item>
        <item name="switchMinWidth">52dp</item>
        <item name="android:background">@null</item>
    </style>

    <style name="AppTheme.AdAttribution" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">start|top</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">10sp</item>
        <item name="android:text">Ad</item>
        <item name="android:background">@color/primary_orange</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:paddingVertical">1dp</item>
        <item name="android:textStyle">bold</item>
    </style>


</resources>