<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <!-- Top Skip Button -->
    <TextView
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:text="Skip"
        android:textColor="#A0A0A0"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center Illustration Container with original background card and the new card image in center -->
    <FrameLayout
        android:id="@+id/cardIllustrationContainer"
        android:layout_width="0dp"
        android:layout_height="230dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintBottom_toTopOf="@+id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnSkip"
        app:layout_constraintVertical_bias="0.35">

        <FrameLayout
            android:id="@+id/staticCardIllustration"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Background Card with muted app items preserved as it was -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#212124"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Top muted item -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="@drawable/bg_panel_badge_search"
                            android:backgroundTint="#3A3A3E" />

                        <View
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_quality_card_unselected"
                            android:backgroundTint="#2E2E32" />

                        <View
                            android:layout_width="140dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="14dp"
                            android:background="@drawable/bg_quality_card_unselected"
                            android:backgroundTint="#2E2E32" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Bottom muted item -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="@drawable/bg_panel_badge_search"
                            android:backgroundTint="#3A3A3E" />

                        <View
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_quality_card_unselected"
                            android:backgroundTint="#2E2E32" />

                        <View
                            android:layout_width="140dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="14dp"
                            android:background="@drawable/bg_quality_card_unselected"
                            android:backgroundTint="#2E2E32" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Center Card Image: Exactly the requested image placed directly in center -->
            <ImageView
                android:id="@+id/ivCenterCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="-6dp"
                android:layout_marginEnd="-6dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/img_set_default_card"
                android:contentDescription="XXVI Video Downloader" />

        </FrameLayout>
    </FrameLayout>

    <!-- Headline Title in #FA9500 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:text="Set Video Downloader\nas default"
        android:textColor="#FA9500"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tvSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="This Will Replace Your Current Home"
        android:textColor="#FFFFFF"
        android:textSize="14.5sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/btnLottie"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Set As Default Button in #FA9500 -->
    <FrameLayout
        android:id="@+id/btnLottie"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_btn_set_default"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@+id/tvFooterInfo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Set As Default"
            android:textColor="#051B0E"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Footer Information -->
    <TextView
        android:id="@+id/tvFooterInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textColor="#8E8E93"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="You Can Change Or Disable These Features Anytime\nFrom Settings > Apps > Default Apps > Home App" />

</androidx.constraintlayout.widget.ConstraintLayout>
