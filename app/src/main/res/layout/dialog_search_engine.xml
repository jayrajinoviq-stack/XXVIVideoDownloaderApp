<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_settings_card"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Orange Badge (Image 1) -->
    <TextView
        android:id="@+id/tvHeaderSearchEngine"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_orange_badge"
        android:gravity="center"
        android:text="Search Engine"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- List Container of Search Engines (Image 1) -->
    <LinearLayout
        android:id="@+id/llEnginesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical" />

</LinearLayout>
