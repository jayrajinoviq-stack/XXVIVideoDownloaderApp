<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingVertical="8dp">

    <LinearLayout
        android:id="@+id/llShortcutContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/ivShortcutIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/btnCancelShortcut"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="-6dp"
                android:layout_marginTop="-6dp"
                android:background="@drawable/bg_shortcut_delete_badge"
                android:clickable="true"
                android:contentDescription="Remove shortcut"
                android:elevation="0dp"
                android:focusable="true"
                android:padding="5dp"
                android:src="@drawable/ic_fab_close"
                android:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvShortcutTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text_dark_brown"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
