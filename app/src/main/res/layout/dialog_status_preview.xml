<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/rlPreviewTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="#80000000"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btnPreviewClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="8dp"
            android:src="@drawable/ic_close_cross"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvPreviewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/btnPreviewClose"
            android:text="Status Preview"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnPreviewShareTop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Share"
            android:padding="8dp"
            android:src="@drawable/ic_menu_share"
            app:tint="#FFFFFF" />
    </RelativeLayout>

    <!-- Center Content: Image or Video -->
    <FrameLayout
        android:id="@+id/flPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/llPreviewBottomBar"
        android:layout_below="@id/rlPreviewTopBar">

        <ImageView
            android:id="@+id/ivPreviewImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <VideoView
            android:id="@+id/vvPreviewVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Video Play/Pause Overlay Indicator -->
        <ImageView
            android:id="@+id/ivVideoPlayPauseOverlay"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_recent_all_circle"
            android:backgroundTint="#80000000"
            android:padding="16dp"
            android:src="@drawable/ic_play_arrow"
            android:visibility="gone"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <!-- Bottom Actions Bar -->
    <LinearLayout
        android:id="@+id/llPreviewBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#99000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Share Button -->
        <LinearLayout
            android:id="@+id/btnPreviewShare"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_wa_tab_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_menu_share"
                app:tint="@color/text_dark_brown" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Share"
                android:textColor="@color/text_dark_brown"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Repost to WhatsApp -->
        <LinearLayout
            android:id="@+id/btnPreviewRepost"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_wa_tab_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/img_logos_whatsapp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Repost"
                android:textColor="@color/text_dark_brown"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Download Button -->
        <LinearLayout
            android:id="@+id/btnPreviewDownload"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_how_to_work_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_download"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvPreviewDownloadBtnText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Save"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
