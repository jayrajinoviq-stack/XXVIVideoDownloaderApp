<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="170dp"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/primary_orange"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Header of Card with title and close button -->
        <LinearLayout
            android:id="@+id/llHeader"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:background="#FFF9F2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvTabTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Facebook" />

            <ImageView
                android:id="@+id/btnCloseTab"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close Tab"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_gray" />
        </LinearLayout>

        <!-- Preview Thumbnail / Mock Page -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="#F8FAFC"
            app:layout_constraintBottom_toTopOf="@id/tvTabUrl"
            app:layout_constraintTop_toBottomOf="@id/llHeader">

            <ImageView
                android:id="@+id/ivTabThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/app_logo" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#08000000" />
        </FrameLayout>

        <!-- URL Subtitle at bottom -->
        <TextView
            android:id="@+id/tvTabUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textColor="@color/text_gray"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="https://www.facebook.com/" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
