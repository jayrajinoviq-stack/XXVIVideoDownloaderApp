<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llHistoryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_home_cream"
    android:orientation="vertical">

    <!-- Top Bar (Screenshots 1, 2, 4) -->
    <LinearLayout
        android:id="@+id/historyTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnHistoryBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_btn_back" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvHistoryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="History"
            android:textColor="@color/text_dark_brown"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Clear All Trash Icon -->
        <ImageView
            android:id="@+id/btnClearAllHistory"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Clear History"
            android:focusable="true"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_trash_can_top" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- History RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistoryList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="24dp"
            tools:listitem="@layout/item_history_row" />

        <!-- Empty State -->
        <TextView
            android:id="@+id/tvHistoryEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No browsing history yet"
            android:textColor="@color/text_gray"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom Native Small Ad Container -->
    <FrameLayout
        android:id="@+id/flNativeAdSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white" />

</LinearLayout>
